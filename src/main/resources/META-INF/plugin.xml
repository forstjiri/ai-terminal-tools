<idea-plugin require-restart="true">
    <id>io.github.forstjiri.aiterminaltool</id>
    <name>OpenCode / Claude Code / Pi / Codex TUI integration</name>
    <vendor>forstjiri</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="terminal-frontend.xml">intellij.terminal.frontend</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.q110.aiterminaltools.settings.AiTerminalToolsSettings"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.bridge.AiTerminalBridgeService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.bridge.AiTerminalDropService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.bridge.AiTerminalFileLinkService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.console.AiConsoleErrorInlayService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.monitor.AiTurnMonitorService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.monitor.AiTurnEventServer"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.monitor.AiTurnSnapshotService"/>
        <projectService serviceImplementation="io.github.q110.aiterminaltools.monitor.AiTurnDiffPresenter"/>
        <applicationConfigurable
            parentId="tools"
            instance="io.github.q110.aiterminaltools.settings.AiTerminalToolsConfigurable"
            id="io.github.q110.aiterminaltools.settings.AiTerminalToolsConfigurable"
            displayName="OpenCode / Claude Code / Pi / Codex TUI integration"/>
        <intentionAction>
            <className>io.github.q110.aiterminaltools.bridge.SendDiagnosticToAiTerminalAction</className>
            <language>any</language>
            <category>AI Terminal Tools</category>
            <skipBeforeAfter>true</skipBeforeAfter>
            <descriptionDirectoryName>SendDiagnosticToAiTerminalAction</descriptionDirectoryName>
        </intentionAction>
        <notificationGroup displayType="BALLOON" id="AI Terminal Tools"/>
        <postStartupActivity implementation="io.github.q110.aiterminaltools.bridge.AiTerminalToolsMenuRegistrar"/>
    </extensions>

    <actions>
        <action
            id="AiTerminalTools.SendSelectionToAiTerminal"
            class="io.github.q110.aiterminaltools.bridge.SendSelectionToAiTerminalAction"
            icon="/icons/send-selection.svg"
            text="Send Selection to AI Terminal"
            description="Send the current editor selection to the active AI terminal">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt COMMA"/>
        </action>
        <action
            id="AiTerminalTools.SendPathToAiTerminal"
            class="io.github.q110.aiterminaltools.bridge.SendPathToAiTerminalAction"
            icon="/icons/send-selection.svg"
            text="Send File Path to AI Terminal"
            description="Send the selected file path to the active AI terminal"/>
        <action
            id="AiTerminalTools.StartOpenCode"
            class="io.github.q110.aiterminaltools.bridge.StartOpenCodeAction"
            icon="/icons/opencode-official-action.svg"
            text="Start OpenCode"
            description="Open a new terminal and run opencode"/>
        <action
            id="AiTerminalTools.StartOpenCode2"
            class="io.github.q110.aiterminaltools.bridge.StartOpenCode2Action"
            icon="/icons/opencode-official-action.svg"
            text="Start OpenCode 2"
            description="Open a new terminal and run OpenCode 2"/>
        <action
            id="AiTerminalTools.StartClaudeCode"
            class="io.github.q110.aiterminaltools.bridge.StartClaudeCodeAction"
            icon="/icons/claude-code-official-action.svg"
            text="Start Claude Code"
            description="Open a new terminal and run claude"/>
        <action
            id="AiTerminalTools.StartPi"
            class="io.github.q110.aiterminaltools.bridge.StartPiAction"
            icon="/icons/pi-action.svg"
            text="Start Pi"
            description="Open a new terminal and run pi"/>
        <action
            id="AiTerminalTools.StartCodex"
            class="io.github.q110.aiterminaltools.bridge.StartCodexAction"
            icon="/icons/send-selection.svg"
            text="Start Codex"
            description="Open a new terminal and run codex"/>
        <action
            id="AiTerminalTools.GenerateCommitMessage"
            class="io.github.q110.aiterminaltools.bridge.GenerateCommitMessageAction"
            icon="/icons/send-selection.svg"
            text="Generate Commit Message"
            description="Generate concise commit messages from the selected files">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
        <action
            id="AiTerminalTools.ShowLastAiTurnDiff"
            class="io.github.q110.aiterminaltools.monitor.ShowLastAiTurnDiffAction"
            text="Show Last AI Turn Diff"
            description="Reopen the diff window for the latest AI changes"/>
        <group
            id="AiTerminalTools.QuerySelectionViaAi"
            popup="true"
            text="Query Selection via AI"
            icon="/icons/send-selection.svg"
            description="AI-powered selection actions">
            <action
                id="AiTerminalTools.ModifySelectionWithAi"
                class="io.github.q110.aiterminaltools.bridge.ModifySelectionWithAiAction"
                text="Modify Selection with AI"
                description="Send selected code to AI and replace it with the modified version"/>
            <action
                id="AiTerminalTools.ExplainSelectionWithAi"
                class="io.github.q110.aiterminaltools.bridge.ExplainSelectionWithAiAction"
                text="Explain with AI"
                description="Send selected code to AI and show a brief explanation"/>
        </group>
    </actions>
</idea-plugin>
